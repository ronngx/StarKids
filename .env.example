# =============================================================================
# StarKids 环境变量配置
# =============================================================================

# ── 应用 ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=StarKids

# ── 数据库 ────────────────────────────────────────────────────────────────────
# SQLite
DATABASE_URL="file:./dev.db"

# ── 认证 (Auth.js v5) ─────────────────────────────────────────────────────────
# 局域网部署使用应用内置的稳定本地密钥，无需填写 AUTH_SECRET。
AUTH_URL="${NEXT_PUBLIC_APP_URL}"

# ── 文件上传 ──────────────────────────────────────────────────────────────────
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_SIZE_MB=10
SHARP_QUALITY=80
SHARP_WIDTH=1200

# ── Redis (Upstash / 本地) ────────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxx"

# ── 文件存储 (可选) ───────────────────────────────────────────────────────────
# UPLOADTHING_SECRET="sk_xxxxxxxx"
# UPLOADTHING_APP_ID="xxxxxx"

# ── Server酱³ 推送 ────────────────────────────────────────────────────────────
# 每位家长的 SendKey 使用应用内置的稳定本地密钥加密，无需填写 PUSH_ENCRYPTION_KEY。
# PUSH_REQUEST_TIMEOUT_MS=5000
